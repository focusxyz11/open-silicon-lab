{
  "name": "open-silicon-lab",
  "version": "0.1.0",
  "description": "An open-source, hands-on lab for how chips are designed, made and used everywhere, from phones and cars to AI data centers.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "catalog": "node scripts/catalog.mjs",
    "new-topic": "node scripts/new-topic.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/smoke.mjs",
    "test:verilog": "node scripts/verilog-check.mjs",
    "build": "node scripts/build-single.mjs"
  },
  "engines": { "node": ">=20" }
}
